# Copy to credit_backend/.env and adjust for your machine.
# Real environment variables take precedence over anything set here.
# Every value below has a working default in app/core/config.py, so the server
# still starts if this file is absent.

# Core database
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5433/credit_scoring

# JWT signing. Use a long random string in anything but local development.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins, or * for any.
CORS_ORIGINS=http://localhost:3000

# Bootstrap accounts, created on first startup only if the username is missing.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_OFFICER_USERNAME=officer
SEED_OFFICER_PASSWORD=officer123
